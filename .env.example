# 이 파일을 .env.local로 복사한 뒤 값을 채우세요. .env.local은 커밋하지 않습니다.
# MongoDB Atlas > Connect > Drivers에서 접속 문자열을 복사해 넣습니다.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# 할 일 데이터를 저장할 데이터베이스 이름
MONGODB_DB=todoapp

# GitHub OAuth App (https://github.com/settings/developers > New OAuth App)
#   Homepage URL:               http://localhost:3001
#   Authorization callback URL: http://localhost:3001/auth/github/callback
#   (배포하면 위 두 주소를 배포 주소로 바꾼 OAuth App을 따로 만드세요)
# Client ID는 앱 화면에 바로 보이고, Client secret은 "Generate a new client secret"을 눌렀을 때
# 한 번만 전체(40자)가 보입니다. 목록에 보이는 끝 8자리는 secret이 아닙니다.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
